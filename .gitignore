# Logs
logs
*.log
npm-debug.log*

# Deps + build output
node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.sw?

# Netlify
.netlify/
# Written by `netlify dev` (it runs edge functions on Deno). Generated, not ours.
deno.lock

# Claude Code agent worktrees (harness state)
.claude/worktrees/

# Working documents kept in the repo root — research scripts, review recaps,
# session notes. They are Jillienne's, not the project's, and a `git add -A`
# will otherwise sweep them into an unrelated commit (it did, 2026-09-24:
# a usability-test .docx landed in the dev-handoff commit).
*.docx
*.pdf.tmp
pd-review-*.html

# Personal Claude settings. `.claude/settings.json` IS committed (it wires the
# framework-protection hook for everyone); this one is per-machine and must not
# be, or one person's local tweaks become everyone's.
.claude/settings.local.json

# Local dev credentials (2026-11-18). `netlify dev` loads these automatically.
# They exist because the site's own BLOBS_TOKEN and github_token are marked
# SECRET on Netlify, so the CLI cannot read them back to inject locally — only
# the deployed runtime sees them. Anything in here is personal and must never
# be committed.
.env
.env.*
!.env.example
